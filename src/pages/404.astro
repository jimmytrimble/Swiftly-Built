---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/Logo.astro';
import Button from '@/components/Button.astro';
---

<Base title="Page not found — Swiftly Built" description="That page does not exist." noindex>
  <section class="nf">
    <div class="container-site nf__inner">
      <Logo variant="mark" size={72} />
      <h1 class="h-hero">Wrong lane.</h1>
      <p>That page does not exist. Head back to the start.</p>
      <Button href="/" variant="primary">
        Go home
      </Button>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: var(--section-y);
  }
  .nf__inner {
    display: grid;
    gap: 24px;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }
  .nf h1,
  .nf p {
    margin: 0;
  }
  .nf p {
    color: var(--color-text-soft);
    font-size: 18px;
  }
</style>
