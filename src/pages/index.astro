---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import Counter from '@/components/Counter.astro';
import Reveal from '@/components/Reveal.astro';
import Icon from '@/components/Icon.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/lib/site';
import { stats } from '@/lib/stats';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((e) => e.data.featured).slice(0, 3);

const layers = [
  {
    icon: 'smartphone',
    title: 'Frontend',
    text: 'SwiftUI for iOS and a native Android build, designed for the device it runs on.',
  },
  {
    icon: 'server',
    title: 'Backend and deployment',
    text: 'Auth, data, APIs, and hosting set up, monitored, and documented so you own it.',
  },
  {
    icon: 'credit-card',
    title: 'Payments',
    text: 'Stripe, Apple Pay, subscriptions, and in-app purchases wired in and tested.',
  },
  {
    icon: 'rocket',
    title: 'App store launch',
    text: 'Store listings, review, release, and 30 days of post-launch support included.',
  },
] as const;

const steps = [
  {
    n: '01',
    title: 'On your marks',
    text: 'Discovery call — 20 minutes on what you need and who it is for.',
  },
  {
    n: '02',
    title: 'Set',
    text: 'Scope and quote — A written scope, your quote, and a delivery date within 48 hours.',
  },
  {
    n: '03',
    title: 'Go',
    text: 'Weekly demo builds — A TestFlight build on your phone every week.',
  },
  {
    n: '04',
    title: 'Finish line',
    text: 'Launch and support — Store submission handled, 30 days of support included.',
    podium: true,
  },
];

const builtFor = [
  'Clinics and practices',
  'Local businesses',
  'Startups',
  'Cleared and defense teams',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${site.url}/#business`,
      name: site.legalName,
      url: site.url,
      email: site.email,
      description: site.description,
      image: `${site.url}/og-default.png`,
      logo: `${site.url}/apple-touch-icon.png`,
      areaServed: 'US',
      address: {
        '@type': 'PostalAddress',
        addressRegion: 'MD',
        addressCountry: 'US',
      },
      founder: { '@id': `${site.url}/#founder` },
      sameAs: [site.linkedin, site.github],
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#founder`,
      name: site.founder,
      jobTitle: 'Founder and Engineer',
      worksFor: { '@id': `${site.url}/#business` },
      url: `${site.url}/about`,
      sameAs: [site.linkedin, site.github],
    },
  ],
};
---

<Base title="Swiftly Built — Fast. Complete. Built to last." description={site.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Section tone="dark" aria-labelledby="hero-h">
    <div class="hero">
      <div class="hero__copy">
        <Eyebrow>iOS · Android · AI · Tech support</Eyebrow>
        <h1 id="hero-h" class="h-hero hero__h">
          <span>Fast.</span>
          <span>Complete.</span>
          <span>
            Built to last<span class="period">.</span>
          </span>
        </h1>
        <p class="hero__sub">
          Production-ready iOS and Android apps, delivered end to end by one engineer. Weeks, not
          quarters.
        </p>
        <div class="hero__actions">
          <Button href="/contact" variant="primary">
            Book a 20-minute call
          </Button>
          <Button href="/work" variant="outline">
            See the work
          </Button>
        </div>
      </div>

      <div class="hero__visual">
        <div class="phone-stack" aria-label="Featured app previews" role="group">
          <div class="phone phone--back">
            <img src="/work/ny-shop.jpg" alt="Naturally Yours Beauty Supply store app preview" />
          </div>
          <div class="phone phone--front">
            <img src="/work/moviebuff-browse.jpg" alt="MovieBuff app preview" class="is-active" />
            <img src="/work/moviebuff-reels.jpg" alt="MovieBuff reels preview" />
            <img src="/work/gameon-login.jpg" alt="GameOn login preview" />
          </div>
        </div>
      </div>
    </div>
  </Section>

  <section class="proof" aria-label="Track record">
    <div class="container-site proof__grid">
      <Counter value={stats.appsShipped} label="apps shipped to the App Store" />
      <Counter
        value={stats.avgTurnaroundWeeks}
        suffix="wks"
        label="average turnaround, scope to store"
      />
      <Counter
        value={stats.defenseYears}
        suffix="yrs"
        label="defense technology and program management"
      />
      <Counter value={stats.clearance} label="active clearance" static />
    </div>
  </section>

  <Section tone="dark" aria-labelledby="get-h">
    <Eyebrow>What you get</Eyebrow>
    <h2 id="get-h" class="h-display section-h">
      One builder. Every layer. Zero hand-offs.
    </h2>
    <p class="section-intro">
      Every project is scoped and quoted on its own. Tell me what you need and I'll come back with a
      price and a delivery date.
    </p>
    <ul class="layers" role="list">
      {layers.map((l, i) => (
        <Reveal as="li" index={i} class="layer">
          <Icon name={l.icon} />
          <h3>{l.title}</h3>
          <p>{l.text}</p>
        </Reveal>
      ))}
    </ul>
  </Section>

  <Section tone="light" aria-labelledby="work-h">
    <div class="split-head">
      <div>
        <Eyebrow onLight>Featured work</Eyebrow>
        <h2 id="work-h" class="h-display section-h">
          Shipped, not promised.
        </h2>
      </div>
      <a href="/work" class="text-link">
        All case studies →
      </a>
    </div>
    <ul class="cards" role="list">
      {featured.map((e, i) => (
        <Reveal as="li" index={i}>
          <CaseStudyCard entry={e} />
        </Reveal>
      ))}
    </ul>
    <div class="more-screens">
      <h3>More screens from shipped apps</h3>
      <div class="screen-row" role="list" aria-label="More app screens">
        {all
          .flatMap((entry) => entry.data.screens.slice(0, 2))
          .slice(0, 6)
          .map((screen, index) => (
            <div class="screen-card" role="listitem" key={index}>
              <Image
                src={screen}
                alt={`App screen ${index + 1}`}
                width={180}
                height={390}
                format="avif"
                quality={60}
                loading="lazy"
              />
            </div>
          ))}
      </div>
    </div>
  </Section>

  <Section tone="dark" aria-labelledby="how-h">
    <Eyebrow>How it works</Eyebrow>
    <h2 id="how-h" class="h-display section-h">
      From the blocks to the finish line.
    </h2>
    <div class="lane-divider" aria-hidden="true">
      <span />
      <span />
      <span />
    </div>
    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <Reveal as="li" index={i} class="step">
          <span class:list={['step__n', { 'step__n--podium': s.podium }]}>
            {s.n} · {s.podium ? 'Finish line' : s.title}
          </span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </Reveal>
      ))}
    </ol>
  </Section>

  <section class="built" aria-label="Who we build for">
    <div class="container-site built__row">
      <span class="built__label">Built for</span>
      <ul role="list" class="built__list">
        {builtFor.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    </div>
  </section>

  <Section tone="dark" aria-labelledby="about-h">
    <div class="about">
      <div class="about__photo" role="img" aria-label="Jamiel Trimble founder photo">
        <span>Founder photo</span>
      </div>
      <div>
        <Eyebrow>About the founder</Eyebrow>
        <h2 id="about-h" class="h-display section-h">
          Built by someone who knows what fast actually means.
        </h2>
        <p class="about__p">
          Jamiel Trimble ran track for Team USA, then spent eight years as an Air Force and Space
          Force officer leading technical programs. Swiftly Built is the engineer he wanted to hire
          and could not find.
        </p>
        <a href="/about" class="text-link">
          Read the story →
        </a>
      </div>
    </div>
  </Section>

  <CtaBand heading="Have an app in mind? Let's scope it this week." cta="Request a quote" />
</Base>

<style>
  .section-h {
    margin: 0 0 40px;
    max-width: 22ch;
  }

  .section-intro {
    margin: 0 0 32px;
    max-width: 62ch;
    color: var(--color-text-soft);
    font-size: clamp(18px, 2vw, 21px);
  }

  .period {
    color: var(--color-podium);
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .hero__h {
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
  }
  .hero__sub {
    font-size: clamp(18px, 2vw, 21px);
    color: var(--color-text-soft);
    max-width: 44ch;
    margin: 0 0 36px;
  }
  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero__visual {
    display: flex;
    justify-content: center;
  }
  .phone-stack {
    position: relative;
    width: 330px;
    height: 620px;
  }
  .phone {
    position: absolute;
    overflow: hidden;
    border-radius: 40px;
    border: 1px solid var(--color-graphite);
    background: var(--color-ink);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.2);
  }
  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phone--back {
    width: 220px;
    height: 478px;
    left: 0;
    top: 80px;
    opacity: 0.85;
  }
  .phone--front {
    width: 285px;
    height: 619px;
    right: 0;
    top: 0;
  }
  .phone--front img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }
  .phone--front img.is-active {
    opacity: 1;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: 2;
    }
    .phone-stack {
      width: 280px;
      height: 520px;
    }
    .phone--back {
      width: 180px;
      height: 400px;
      top: 60px;
    }
    .phone--front {
      width: 230px;
      height: 500px;
    }
  }

  .proof {
    background: var(--color-ink);
    border-top: 1px solid var(--color-graphite);
    border-bottom: 1px solid var(--color-graphite);
  }
  .proof__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-block: 24px;
  }
  @media (max-width: 767.98px) {
    .proof__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .layer {
    background: var(--color-ink);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-md);
    padding: 28px;
  }
  .layer h3 {
    font-size: 20px;
    margin: 20px 0 10px;
  }
  .layer p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 15.5px;
  }
  @media (max-width: 1000px) {
    .layers {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .layers {
      grid-template-columns: 1fr;
    }
  }

  .split-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .more-screens {
    margin-top: 40px;
  }
  .more-screens h3 {
    margin: 0 0 18px;
    font-size: 22px;
    color: var(--color-jet);
  }
  .screen-row {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x proximity;
  }
  .screen-card {
    flex: 0 0 180px;
    scroll-snap-align: start;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--color-mist);
    background: var(--color-white);
  }
  .screen-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lane-divider {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    margin: 0 0 30px;
  }
  .lane-divider span {
    height: 2px;
    display: block;
    border-radius: 999px;
  }
  .lane-divider span:nth-child(1) {
    background: #3f3f46;
  }
  .lane-divider span:nth-child(2) {
    background: var(--color-electric);
  }
  .lane-divider span:nth-child(3) {
    background: var(--color-podium);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .step {
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .step__n {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    color: var(--color-electric);
    letter-spacing: 0.1em;
  }
  .step__n--podium {
    color: var(--color-podium);
  }
  .step h3 {
    font-size: 20px;
    margin: 14px 0 8px;
  }
  .step p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 15.5px;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .built {
    background: var(--color-ink);
    border-top: 1px solid var(--color-graphite);
    border-bottom: 1px solid var(--color-graphite);
  }
  .built__row {
    display: flex;
    align-items: baseline;
    gap: 28px;
    flex-wrap: wrap;
    padding-block: 28px;
  }
  .built__label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
  .built__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .built__list li + li::before {
    content: '·';
    color: var(--color-electric);
    margin-right: 28px;
  }

  .about {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 64px;
    align-items: center;
  }
  .about__photo {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 380 / 440;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--color-graphite);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: 14px;
  }
  .about__p {
    color: var(--color-text-soft);
    font-size: 18px;
    max-width: 52ch;
    margin: 0 0 24px;
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<script>
  const phoneFront = document.querySelector('.phone--front');
  const slides = phoneFront ? Array.from(phoneFront.querySelectorAll('img')) : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (slides.length > 1 && !reduce) {
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const show = (index: number) => {
      slides.forEach((img, i) => img.classList.toggle('is-active', i === index));
    };
    const next = () => {
      current = (current + 1) % slides.length;
      show(current);
    };
    const start = () => {
      if (!timer) timer = setInterval(next, 4000);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };
    phoneFront?.addEventListener('mouseenter', stop);
    phoneFront?.addEventListener('mouseleave', start);
    phoneFront?.addEventListener('focusin', stop);
    phoneFront?.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
