---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/lib/site';

const tiers = [
  {
    name: 'Sprint',
    get: 'Clickable prototype or MVP, iOS first, one core flow',
    scope: '2 to 3 weeks',
    price: '~$3,500',
  },
  {
    name: 'Launch',
    get: 'Full production app, iOS and Android, backend, auth, store submission',
    scope: '6 to 10 weeks',
    price: '~$8,000',
  },
  {
    name: 'Scale',
    get: 'Launch plus payments, admin dashboard, analytics, CI/CD',
    scope: '10 to 16 weeks',
    price: '~$12,000',
  },
  {
    name: 'Retainer',
    get: 'Maintenance, OS updates, feature work',
    scope: 'Monthly',
    price: 'By scope',
  },
  {
    name: 'Advisory',
    get: 'Technical due diligence, architecture review, fractional CTO',
    scope: 'By project',
    price: 'By scope',
  },
];

const included = [
  'Written scope within 48 hours',
  'Weekly TestFlight builds',
  'Store submission',
  '30-day support',
  'Source code and documentation handed over',
  'Milestone payments 40/40/20',
];

const services = [
  {
    title: 'Mobile apps',
    text: 'Native iOS and Android apps, designed and built end to end — from first sketch to the App Store and Play Store.',
  },
  {
    title: 'Websites and landing pages',
    text: 'Fast, modern marketing sites (like this one) that load instantly and read well on every screen.',
  },
  {
    title: 'Backend and deployment',
    text: 'Auth, databases, APIs, and hosting set up, monitored, and documented so you fully own it.',
  },
  {
    title: 'Payments',
    text: 'Stripe, Apple Pay, subscriptions, and in-app purchases wired in and tested.',
  },
  {
    title: 'AI features',
    text: 'Smart features powered by on-device or API-based AI, built in where they add real value.',
  },
  {
    title: 'Store launch and support',
    text: 'Store listings, review, and release handled — plus 30 days of post-launch support included.',
  },
  {
    title: 'Business IT and email',
    text: 'Company email setup and management, plus day-to-day IT and tech support for small teams.',
  },
  {
    title: 'Tech advice and support',
    text: 'Device and network troubleshooting, and straight technical guidance when you just need an answer.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/services#service`,
  name: site.legalName,
  url: `${site.url}/services`,
  email: site.email,
  description: 'iOS and Android app development, delivered end to end by one engineer.',
  areaServed: 'US',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: tiers.map((t) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: t.name, description: t.get },
    })),
  },
};
---

<Base
  title="Services and pricing — Swiftly Built"
  description="Everything Swiftly Built offers — apps, websites, backend, payments, AI, business IT and email — with rough starting prices and a firm quote before any work begins."
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Section tone="dark" aria-labelledby="svc-h">
    <h1 id="svc-h" class="h-display page-h">
      Clear scope. Honest pricing.
    </h1>
    <p class="intro">
      The numbers below are rough starting points, not final quotes — every project is priced on its
      own once I know what you need. You'll always get a firm price and a delivery date before any
      work begins, so don't let a figure stop you from reaching out.
    </p>

    <div class="table-wrap" tabindex="0" role="region" aria-label="Pricing tiers, scrollable">
      <table class="tiers">
        <thead>
          <tr>
            <th scope="col">Tier</th>
            <th scope="col">What you get</th>
            <th scope="col">Typical scope</th>
            <th scope="col">Starting at</th>
          </tr>
        </thead>
        <tbody>
          {tiers.map((t) => (
            <tr>
              <th scope="row">{t.name}</th>
              <td>{t.get}</td>
              <td>{t.scope}</td>
              <td class="price">{t.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="tiers-note">
      Rough starting points — final pricing depends on the features and scope of your project.
      <a href="/contact" class="text-link">
        Reach out for a quote
      </a>{' '}
      and we'll scope it together, with a firm number before any work begins.
    </p>
  </Section>

  <Section tone="light" aria-labelledby="offer-h">
    <Eyebrow onLight>What I offer</Eyebrow>
    <h2 id="offer-h" class="h-display offer-h">
      Everything I can help with.
    </h2>
    <p class="offer-intro">
      From a first idea to a shipped app — and the day-to-day tech and IT to keep it all running.
    </p>
    <ul class="offer-grid" role="list">
      {services.map((s) => (
        <li class="offer-card">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="raised" aria-labelledby="inc-h">
    <div class="two">
      <div>
        <h2 id="inc-h">What is included in every project</h2>
        <ul class="check" role="list">
          {included.map((i) => (
            <li>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-electric)"
                stroke-width="2.5"
                stroke-linecap="square"
                aria-hidden="true"
              >
                <path d="M5 12.5l4.5 4.5L19 7" />
              </svg>
              {i}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Changes</h2>
        <p>
          Scope is locked at discovery. Anything added after that is a written change order with its
          own price and date, agreed before work starts.
        </p>
      </div>
    </div>
  </Section>

  <CtaBand />
</Base>

<style>
  .page-h {
    margin: 0 0 20px;
  }
  .intro {
    font-size: clamp(18px, 2vw, 21px);
    color: var(--color-text-soft);
    max-width: 56ch;
    margin: 0 0 48px;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-md);
    background: var(--color-ink);
  }
  .tiers {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 16px;
  }
  .tiers th,
  .tiers td {
    text-align: left;
    padding: 18px 22px;
    border-bottom: 1px solid var(--color-graphite);
    vertical-align: top;
  }
  .tiers thead th {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
  .tiers tbody th {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .tiers tbody tr:last-child th,
  .tiers tbody tr:last-child td {
    border-bottom: 0;
  }
  .tiers td {
    color: var(--color-text-soft);
  }
  .price {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-white);
    white-space: nowrap;
  }
  .two {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
  }
  .two h2 {
    font-size: 28px;
    margin: 0 0 20px;
  }
  .two p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 17px;
    max-width: 48ch;
  }
  .check {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .check li {
    display: flex;
    gap: 12px;
    align-items: center;
    font-weight: 500;
  }
  @media (max-width: 800px) {
    .two {
      grid-template-columns: 1fr;
    }
  }

  .tiers-note {
    margin: 20px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-soft);
    max-width: 72ch;
  }

  .offer-h {
    margin: 0 0 16px;
    max-width: 24ch;
  }
  .offer-intro {
    font-size: clamp(17px, 2vw, 20px);
    max-width: 60ch;
    margin: 0 0 40px;
    color: var(--color-text-muted-light);
  }
  .offer-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .offer-card {
    background: var(--color-white);
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .offer-card h3 {
    font-size: 18px;
    margin: 0 0 8px;
    color: var(--color-jet);
  }
  .offer-card p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-text-muted-light);
  }
  @media (max-width: 1000px) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .offer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
