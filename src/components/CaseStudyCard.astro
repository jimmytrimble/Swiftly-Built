---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'work'>;
  loading?: 'lazy' | 'eager';
  headingLevel?: 'h2' | 'h3';
}
const { entry, loading = 'lazy', headingLevel: Heading = 'h3' } = Astro.props;
const d = entry.data;
const meta = `${d.client} · ${d.turnaroundWeeks} weeks · ${d.platforms.join(' and ')}`;
---

<a href={`/work/${entry.id}`} class="card">
  <Image
    src={d.cover}
    alt={`${d.title} app cover`}
    width={600}
    height={400}
    format="avif"
    quality={60}
    loading={loading}
    class="card__cover"
  />
  <div class="card__body">
    <Heading class="card__title">{d.title}</Heading>
    <p class="card__meta">{meta}</p>
    <p class="card__result">{d.result}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-jet);
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .card:hover {
    border-color: var(--color-track);
  }
  .card__cover {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .card__body {
    padding: 22px 24px 26px;
  }
  .card__title {
    font-size: 22px;
    margin: 0 0 8px;
  }
  .card__meta {
    margin: 0 0 10px;
    font-size: 14px;
    color: var(--color-text-muted-light);
  }
  .card__result {
    margin: 0;
    font-weight: 500;
    line-height: 1.45;
  }
</style>
