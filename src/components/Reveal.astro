---
/**
 * Fade + 12px rise when scrolled into view. Pass `index` for staggered
 * left-to-right reveals inside a horizontal group. Disabled under reduced motion.
 */
interface Props {
  index?: number;
  class?: string;
  as?: 'div' | 'li' | 'article';
}
const { index = 0, class: className = '', as: Tag = 'div' } = Astro.props;
---

<Tag data-reveal class={className} style={index ? `--reveal-delay:${index * 70}ms` : undefined}>
  <slot />
</Tag>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nodes = document.querySelectorAll('[data-reveal]');
  if (reduce || !('IntersectionObserver' in window)) {
    nodes.forEach((n) => n.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -5% 0px' },
    );
    nodes.forEach((n) => io.observe(n));
  }
</script>
