---
/**
 * Brand logo: the running figure mark plus the "Swiftly Built" wordmark in
 * Inter Tight 800. The mark is electric blue on dark surfaces and the black
 * (original) mark on light surfaces. Source art is 445×350.
 */
interface Props {
  variant?: 'mark' | 'horizontal' | 'stacked';
  size?: number;
  onLight?: boolean;
  class?: string;
}
const { variant = 'horizontal', size = 32, onLight = false, class: className = '' } = Astro.props;
const wordColor = onLight ? 'var(--color-jet)' : 'var(--color-white)';
const markSize = Math.max(28, size);
const markWidth = Math.round((markSize * 445) / 350);
const markSrc = onLight ? '/brand/mark-original.png' : '/brand/mark-electric.png';
---

<span
  class:list={['logo', `logo--${variant}`, className]}
  style={`--logo-size:${markSize}px; --word-size:${variant === 'stacked' ? markSize * 0.8 : markSize * 0.72}px; color:${wordColor};`}
>
  <img
    class="logo__mark"
    src={markSrc}
    width={markWidth}
    height={markSize}
    alt=""
    aria-hidden="true"
    decoding="async"
  />

  {variant !== 'mark' && (
    <span class="logo__word" aria-hidden="true">
      Swiftly <span class="logo__built">Built</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.3);
    line-height: 1;
    text-decoration: none;
  }

  .logo--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--logo-size) * 0.22);
  }

  .logo__mark {
    display: block;
    flex: none;
  }

  .logo__word {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--word-size);
    letter-spacing: -0.035em;
    transform: skewX(-8deg);
    white-space: nowrap;
    color: inherit;
  }

  .logo__built {
    color: var(--color-electric);
  }
</style>
