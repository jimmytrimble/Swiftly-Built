---
/**
 * Brand logo. The chevron is always electric blue; the baseline uses currentColor
 * (white on dark, jet on light). Wordmark: "Swiftly Built" in Inter Tight 800.
 */
interface Props {
  variant?: 'mark' | 'horizontal' | 'stacked';
  size?: number; // mark height in px
  onLight?: boolean;
  class?: string;
}
const { variant = 'horizontal', size = 32, onLight = false, class: className = '' } = Astro.props;
const color = onLight ? 'var(--color-jet)' : 'var(--color-white)';
const wordSize = variant === 'stacked' ? size * 0.75 : size * 0.78;
---

<span
  class:list={['logo', `logo--${variant}`, className]}
  style={`--logo-size:${size}px; --word-size:${wordSize}px; color:${color}`}
>
  <svg
    viewBox="0 0 64 64"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Swiftly Built"
    class="logo__mark"
    width={size}
    height={size}
  >
    <path
      d="M16 9 L44 31 L16 53"
      fill="none"
      stroke="#0A84FF"
      stroke-width="12"
      stroke-linecap="square"
      stroke-linejoin="miter"
    ></path>
    <path
      d="M6 60 H40"
      fill="none"
      stroke="currentColor"
      stroke-width="6"
      stroke-linecap="square"
    ></path>
  </svg>
  {variant !== 'mark' && (
    <span class="logo__word" aria-hidden="true">
      Swiftly <span class="logo__built">Built</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.35);
    line-height: 1;
    text-decoration: none;
  }
  .logo--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--logo-size) * 0.3);
  }
  .logo__mark {
    flex: none;
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--word-size);
    letter-spacing: -0.035em;
    white-space: nowrap;
    color: inherit;
  }
  .logo--horizontal .logo__built {
    color: var(--color-electric);
  }
</style>
