---
import Logo from './Logo.astro';
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-site footer__inner">
    <div class="footer__brand">
      <a href="/" aria-label="Swiftly Built, home">
        <Logo variant="horizontal" size={26} />
      </a>
      <p class="footer__legal">{site.legalName}</p>
      <p class="footer__meta">Washington, D.C. area · Veteran-owned</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer__links">
        <li>
          <a href={site.linkedin} rel="me noopener" target="_blank">
            LinkedIn
          </a>
        </li>
        <li>
          <a href={site.github} rel="me noopener" target="_blank">
            GitHub
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="container-site footer__bottom">
    <p>
      © {year} {site.legalName}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-jet);
    border-top: 1px solid var(--color-graphite);
    color: var(--color-text-muted);
    font-size: 14px;
  }
  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    padding-block: 48px 32px;
    flex-wrap: wrap;
  }
  .footer__brand a {
    text-decoration: none;
    color: var(--color-white);
    display: inline-flex;
  }
  .footer__legal {
    margin: 16px 0 4px;
    color: var(--color-text-soft);
    font-weight: 500;
  }
  .footer__meta {
    margin: 0;
  }
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer__links a {
    color: var(--color-text-soft);
    text-decoration: none;
    font-weight: 500;
  }
  .footer__links a:hover {
    color: var(--color-electric);
  }
  .footer__bottom {
    padding-block: 16px 32px;
  }
  .footer__bottom p {
    margin: 0;
  }
</style>
